{
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleAttributePerLine": true,
    "insertPragma": false,
    "jsxSingleQuote": false,
    "printWidth": 120,
    "proseWrap": "preserve",
    "quoteProps": "preserve",
    "requirePragma": false,
    "tabWidth": 4,
    "useTabs": false,
    "vueIndentScriptAndStyle": false,
    "endOfLine": "lf",
    "singleQuote": true,
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "printWidth": 10
            }
        },
        {
            "files": ".prettierrc",
            "options": {
                "parser": "json"
            }
        },
        {
            "files": "*.html",
            "options": {
                "htmlWhitespaceSensitivity": "ignore",
                "jsxBracketSameLine": false,
                "semi": true,
                "trailingComma": "none"
            }
        }
    ]
}
